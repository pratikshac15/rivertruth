# Copy this file to .env and fill in real values. Never commit .env.

# --- DATA: Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Optional: a separate READ-ONLY Zetaris key used for SQL written by the agents (recommended)
ZETARIS_AGENT_API_KEY=

# --- POWER: Meterless Nightshift (from Nightshift > Console) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=rivertruth
# Explicit Nemotron models (Nightshift build >= Oct 23 honours explicit IDs). FAST = investigator, DEEP = planner/critic/reporter
FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Sent as the user-agent to USGS, NOAA and Open-Meteo (they ask for a contact; use a project URL or email you choose)
RIVERTRUTH_CONTACT=rivertruth-hackathon-demo

# Total time for one investigation, and one model call (seconds)
RUN_DEADLINE_S=420
CALL_TIMEOUT_S=180

# Set to true to run with cached data and recorded model replies (no Zetaris/Nightshift needed)
SAMPLE_MODE=false
